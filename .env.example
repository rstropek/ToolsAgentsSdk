OPENAI_API_KEY=

# --- Model selection ---
TRIAGE_MODEL=gpt-5.4
STATS_MODEL=gpt-5.4

# --- Behavior ---
REASONING_EFFORT=high                   # minimal | low | medium | high
LOG_LEVEL=info                          # info | debug
TRACE_ENABLED=true

# --- Codex (used in Increment 4) ---
# Command and args for launching Codex as an MCP server.
CODEX_COMMAND=codex
CODEX_MCP_ARGS=mcp-server
CODEX_MODEL=gpt-5.4
CODEX_REASONING_EFFORT=high
